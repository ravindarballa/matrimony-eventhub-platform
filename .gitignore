# dependencies
node_modules/
.npm/

# builds
dist/
build/
tmp/
out-tsc/
.angular/

# environment - never commit secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
logs/

# testing
coverage/
.nyc_output/
playwright-report/
test-results/

# editors
.idea/
*.swp
.DS_Store
Thumbs.db

# local infrastructure state
infrastructure/docker/.data/
infrastructure/terraform/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# typescript incremental build state
*.tsbuildinfo

# angular build cache
.angular/cache/

# Locally stored uploads. Never committed; regenerated by use.
apps/api/var/

# Scratch imagery kept locally while working on the matrimony screens. Served
# straight out of public/ by the dev server, so it works without being tracked -
# and staying untracked is the point: this folder is where third-party photos
# get dropped in to try something, and git history is the one place they must
# not end up.
apps/web/public/matrimony/
