# Copy to .env for local development. Never commit the real .env.

NODE_ENV=development
PORT=3000
# URI versioning appends /v1, so this must NOT already contain it.
API_PREFIX=api
CORS_ORIGIN=http://localhost:4200

# Mongo must be a replica set - transactions are used for the booking slot lock.
MONGODB_URI=mongodb://127.0.0.1:27077/eventhub?replicaSet=testset&directConnection=true

# 'memory' is fine for one API process. Anything running more than one MUST
# set this to 'redis', or each process enforces its own separate quota.
THROTTLE_STORE=memory

REDIS_HOST=localhost
REDIS_PORT=6379

# Access tokens are short-lived and held in memory by the client.
JWT_ACCESS_SECRET=dev-only-change-me-min-32-characters-long
JWT_ACCESS_TTL=900
# Refresh tokens live in an httpOnly cookie and are hashed at rest.
JWT_REFRESH_SECRET=dev-only-change-me-different-32-chars
JWT_REFRESH_TTL=2592000

OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Local AWS stand-in
AWS_REGION=ap-south-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=eventhub-media-dev

# fake = no credentials, no network; the whole payment flow still runs.
PAYMENT_GATEWAY=fake
PAYMENT_FAKE_WEBHOOK_SECRET=fake_webhook_secret_local_dev

# Razorpay test keys - the webhook secret is what verifies inbound callbacks.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder

# ---------------------------------------------------------------- media
# Where uploaded photos go. 'local' writes under apps/api/var/uploads and needs
# nothing else; 's3' is for anything running more than one API process, since
# the instance serving a photo is rarely the one that stored it.
MEDIA_DRIVER=local
# Optional. Empty means apps/api/var/uploads.
MEDIA_LOCAL_ROOT=
# Only read when MEDIA_DRIVER=s3. Credentials are NOT read from here - on AWS
# they come from the task or instance role.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
# Set only for an S3-compatible store such as MinIO.
MEDIA_S3_ENDPOINT=
